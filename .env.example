# Variables de entorno requeridas por el backend. Valores de ejemplo, ficticios.
# Este archivo es solo documentacion: Spring Boot no lo carga automaticamente.
# No se agrego ninguna libreria de carga de .env: el equipo decidio no
# incorporar dependencias nuevas al proyecto sin necesidad justificada.
#
# Para que estas variables lleguen a la aplicacion hay que definirlas en el
# entorno real antes de levantar el proceso, por ejemplo:
#   - export VAR=valor                  (shell interactiva)
#   - configuracion de run/debug del IDE (Eclipse/IntelliJ/VSCode)
#   - systemd: EnvironmentFile=/ruta/privada/con/valores/reales
#   - docker: --env-file / env_file en docker-compose (apuntando a un
#     archivo real que NO se versiona, no a este .env.example)
#   - variables/secrets del entorno de CI o del proveedor de hosting
#
# Nunca completar este archivo con valores reales ni versionar el archivo
# real que los contenga (.env, .env.local, etc. ya estan excluidos en
# .gitignore).

# Obligatorias (sin valor por defecto en el codigo; el arranque falla si faltan)
DB_USERNAME=usuario_ejemplo
DB_PASSWORD=contrasenia_ejemplo
JWT_SECRET=clave_de_firma_jwt_ejemplo_no_usar_en_serio

# Infraestructura MySQL local: obligatoria para compose.local.yaml.
# Guardar el valor real solo en .env.mysql; Spring no usa esta cuenta root.
MYSQL_ROOT_PASSWORD=contrasenia_root_ejemplo_no_usar

# Perfil runtime usado en desarrollo (independiente del perfil Maven -P).
SPRING_PROFILES_ACTIVE=mysqldev
